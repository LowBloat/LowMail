{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window permissions on every platform",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-focus",
    "dialog:allow-save",
    "dialog:allow-open",
    "notification:default",
    "process:allow-exit",
    "opener:default",
    "deep-link:default"
  ]
}
